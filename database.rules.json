{
  "rules": {
    "disputeRequests": {
      "$pushId": {
        ".read": "root.child('admins').child(auth.uid).val() == true",
        ".write": "!data.exists() && newData.hasChildren(['email','createdAt'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}
