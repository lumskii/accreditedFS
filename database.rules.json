{
  "rules": {
    "disputeRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').child('admin').val() == true",
      "$pushId": {
        ".read": "root.child('users').child(auth.uid).child('roles').child('admin').val() == true",
        ".write": "!data.exists() && newData.hasChildren(['email','createdAt'])"
      }
    },
    "planChangeRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').child('admin').val() == true",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
        ".validate": "newData.hasChildren(['userId','userEmail','currentPlan','newPlan','currentPrice','newPrice','paymentMode','status','requestedAt'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
        "uploads": {
          "$uploadId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
            ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('admin').val() == true)",
            ".validate": "newData.hasChildren(['name','url','uploadedAt']) && newData.child('name').isString() && newData.child('url').isString() && newData.child('uploadedAt').isString()"
          }
        }
      },
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').child('admin').val() == true"
    },
    "payments_by_session": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').child('admin').val() == true",
      ".write": false
    },
    "payments_orphans": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').child('admin').val() == true",
      ".write": false
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}
