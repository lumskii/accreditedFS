    "api/health-check.js": {
      "maxDuration": 10
    },
    "api/test-auth.js": {
      "maxDuration": 10
    },
    "api/set-admin.js": {
      "maxDuration": 10
    },
    "api/admin-users.js": {
      "maxDuration": 15
    },
    "api/upload-blob.js": {
      "maxDuration": 15
    },
    "api/delete-upload.js": {
