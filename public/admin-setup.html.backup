<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Setup - Accredited Financial Services</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen py-12">
    <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Admin Setup</h1>
            <p class="text-gray-600 mt-2">Grant admin privileges to a user</p>
        </div>

        <div id="setupForm">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">User Email</label>
                    <input 
                        type="email" 
                        id="userEmail" 
                        placeholder="Enter email to make admin"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Admin Setup Secret</label>
                    <input 
                        type="password" 
                        id="adminSecret" 
                        placeholder="Enter admin setup secret"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                    <p class="text-xs text-gray-500 mt-1">Contact the developer for the secret key</p>
                </div>

                <button 
                    onclick="grantAdminRole()" 
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors"
                >
                    Grant Admin Role
                </button>
            </div>
        </div>

        <div id="result" class="mt-4 hidden"></div>
        
        <div class="mt-6 text-center">
            <a href="/admin/login" class="text-blue-600 hover:text-blue-800 text-sm">Go to Admin Login →</a>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
        import { getAuth, signInWithEmailAndPassword } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js';

        // Load Firebase config from environment variables (same as React app)
        const firebaseConfig = {
            apiKey: import.meta.env?.VITE_FIREBASE_API_KEY || "AIzaSyBqowhuOkEhO5PIR8NkgI_4QgWfN7-_7F0",
            authDomain: import.meta.env?.VITE_FIREBASE_AUTH_DOMAIN || "accreditedfs.firebaseapp.com",
            databaseURL: import.meta.env?.VITE_FIREBASE_DATABASE_URL || "https://accreditedfs-default-rtdb.firebaseio.com",
            projectId: import.meta.env?.VITE_FIREBASE_PROJECT_ID || "accreditedfs",
            storageBucket: import.meta.env?.VITE_FIREBASE_STORAGE_BUCKET || "accreditedfs.firebasestorage.app",
            messagingSenderId: import.meta.env?.VITE_FIREBASE_MESSAGING_SENDER_ID || "372459430096",
            appId: import.meta.env?.VITE_FIREBASE_APP_ID || "1:372459430096:web:17e6fcdae74df87c63b949",
            measurementId: import.meta.env?.VITE_FIREBASE_MEASUREMENT_ID || "G-8CXWKS7E31"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        window.grantAdminRole = async function() {
            const userEmail = document.getElementById('userEmail').value;
            const adminSecret = document.getElementById('adminSecret').value;
            const resultDiv = document.getElementById('result');

            if (!userEmail || !adminSecret) {
                showResult('Please fill in all fields', 'error');
                return;
            }

            try {
                showResult('Processing...', 'info');
                
                // Call our API to set admin role
                const response = await fetch('https://accredited-8w89sev1g-mikes-projects-eb8d5010.vercel.app/api/set-admin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        userEmail: userEmail,
                        adminSecret: adminSecret
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    showResult(`Success! Admin role granted to ${userEmail}. You can now login at /admin/login`, 'success');
                    
                    // Clear the form
                    document.getElementById('userEmail').value = '';
                    document.getElementById('adminSecret').value = '';
                } else {
                    showResult(`Error: ${data.error}`, 'error');
                }

            } catch (error) {
                console.error('Setup error:', error);
                showResult(`Setup failed: ${error.message}`, 'error');
            }
        };

        function showResult(message, type) {
            const resultDiv = document.getElementById('result');
            resultDiv.className = `mt-4 p-3 rounded-md ${
                type === 'success' ? 'bg-green-100 text-green-700 border border-green-200' :
                type === 'error' ? 'bg-red-100 text-red-700 border border-red-200' :
                'bg-blue-100 text-blue-700 border border-blue-200'
            }`;
            resultDiv.textContent = message;
            resultDiv.classList.remove('hidden');
        }
    </script>
</body>
</html>